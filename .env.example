# Local Windows folder used for SQLite and all imported/generated media.
CLIPPER_DATA_DIR=C:/1Clipping/data

# Optional: set this to /cookies/cookies.txt after placing the file in ./cookies.
YT_DLP_COOKIES_FILE=
YT_DLP_COOKIES_DIR=./cookies

# Local Ollama endpoint. The Docker default uses the optional `ollama` service.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
